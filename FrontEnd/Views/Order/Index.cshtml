@model FrontEnd.Models.PagedResultViewModel<FrontEnd.Models.OrderListDto>

<div class="container mt-4">
    <h2>Daftar Sales Order</h2>
    
    <!-- Filter Header -->
    <form method="get" class="row g-3 mb-3">
        <div class="col-md-4">
            <input type="text" name="keyword" class="form-control" placeholder="Cari SO No / Customer..." value="@ViewBag.Keyword">
        </div>
        <div class="col-md-3">
            <input type="date" name="orderDate" class="form-control" value="@ViewBag.OrderDate">
        </div>
        <div class="col-md-5">
            <button type="submit" class="btn btn-primary">Cari</button>
            <a href="/Order/Index" class="btn btn-secondary">Reset</a>
            <a href="http://localhost:5002/api/orders/export?keyword=@ViewBag.Keyword&orderDate=@ViewBag.OrderDate" class="btn btn-success">Export Excel</a>
            <a href="/Order/Create" class="btn btn-success float-end">+ Order Baru</a>
        </div>
    </form>

    <!-- Data Table -->
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>SO ID</th>
                <th>SO No</th>
                <th>Order Date</th>
                <th>Customer</th>
                <th>Address</th>
                <th>Grand Total</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.SalesSoId</td>
                        <td>@item.SoNo</td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.CustomerName</td>
                        <td>@item.Address</td>
                        <td>Rp @item.GrandTotal.ToString("N0")</td>
                        <td>
                            <a href="/Order/Edit/@item.SalesSoId" class="btn btn-sm btn-warning">Edit</a>
                            <button onclick="deleteOrder(@item.SalesSoId)" class="btn btn-sm btn-danger">Hapus</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">Data tidak ditemukan.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Info & Pagination -->
    @if (Model.TotalCount > 0)
    {
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Menampilkan @((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) dari @Model.TotalCount data
            </small>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?keyword=@ViewBag.Keyword&orderDate=@ViewBag.OrderDate&pageNumber=@(Model.PageNumber - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="?keyword=@ViewBag.Keyword&orderDate=@ViewBag.OrderDate&pageNumber=@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?keyword=@ViewBag.Keyword&orderDate=@ViewBag.OrderDate&pageNumber=@(Model.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

<script>
function deleteOrder(id) {
    Swal.fire({
        title: 'Apakah Anda yakin?',
        text: "Data order yang dihapus tidak dapat dikembalikan!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Ya, Hapus!',
        cancelButtonText: 'Batal',
        reverseButtons: true
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const res = await fetch(`/Order/Delete/${id}`, { method: 'POST' });
                const responseData = await res.json();

                if (res.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil!',
                        text: responseData.message || 'Data order berhasil dihapus.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Gagal!', responseData.message || 'Terjadi kesalahan.', 'error');
                }
            } catch (err) {
                Swal.fire('Error!', 'Gagal menghubungi server.', 'error');
            }
        }
    });
}
</script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Berhasil!',
            text: '@TempData["SuccessMessage"]',
            timer: 2000,
            showConfirmButton: false
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Gagal!',
            text: '@TempData["ErrorMessage"]'
        });
    </script>
}